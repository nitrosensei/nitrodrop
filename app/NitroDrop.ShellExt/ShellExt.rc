// NitroDrop.ShellExt.dll version resource (product name/version metadata, enforced by the SignPath signing policy).
// build.ps1 passes NITRO_VER_MAJOR/MINOR/BUILD/REV and NITRO_VER_STR (the release version, a.b.c.d).
#include <winver.h>

#ifndef NITRO_VER_MAJOR
#define NITRO_VER_MAJOR 0
#define NITRO_VER_MINOR 0
#define NITRO_VER_BUILD 0
#define NITRO_VER_REV   0
#define NITRO_VER_STR   "0.0.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    NITRO_VER_MAJOR, NITRO_VER_MINOR, NITRO_VER_BUILD, NITRO_VER_REV
 PRODUCTVERSION NITRO_VER_MAJOR, NITRO_VER_MINOR, NITRO_VER_BUILD, NITRO_VER_REV
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Nitrobyte"
            VALUE "FileDescription",  "NitroDrop Explorer menu"
            VALUE "FileVersion",      NITRO_VER_STR
            VALUE "InternalName",     "NitroDrop.ShellExt"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Nitrobyte - Emre Can Temur. MIT License."
            VALUE "OriginalFilename", "NitroDrop.ShellExt.dll"
            VALUE "ProductName",      "NitroDrop"
            VALUE "ProductVersion",   NITRO_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
