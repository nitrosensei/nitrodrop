<Project Sdk="Microsoft.NET.Sdk">

  <!-- Chrome/Edge native messaging host: stdio (length-prefixed JSON) <-> NitroDrop.Sync named pipe.
       Kept tiny: only the framing file is shared with Nitro.Sync. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NitroDrop.SyncHost</AssemblyName>
    <RootNamespace>Nitro.Sync.Host</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Nitro.Sync\Ipc\NativeMessaging.cs" Link="Shared\NativeMessaging.cs" />
    <Compile Include="..\Nitro.Sync\Ipc\PipeConnect.cs" Link="Shared\PipeConnect.cs" />
  </ItemGroup>

</Project>
