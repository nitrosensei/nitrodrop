<Project Sdk="Microsoft.NET.Sdk">

  <!-- Read-only Bluetooth inspector: lists paired devices, GATT services (ANCS/AMS) and RFCOMM services (MAP/PBAP/HFP).
       Never pairs, never writes. Unpackaged WinRT via the Windows TFM (same pattern as AirDrop.App). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>nitro-continuity-probe</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nitro.Continuity\Nitro.Continuity.csproj" />
  </ItemGroup>

</Project>
