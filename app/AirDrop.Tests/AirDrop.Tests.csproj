<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- UI strings: Loc/Plural + every Localization/*.resx (same generated <Module>Strings classes as the app). -->
  <PropertyGroup>
    <NitroLocLinked>true</NitroLocLinked>
  </PropertyGroup>
  <Import Project="..\AirDrop.App\Localization\Localization.targets" />

  <ItemGroup>
    <ProjectReference Include="..\AirDrop.Core\AirDrop.Core.csproj" />
    <ProjectReference Include="..\Nitro.Continuity\Nitro.Continuity.csproj" />
    <ProjectReference Include="..\Nitro.Sync\Nitro.Sync.csproj" />
    <ProjectReference Include="..\Nitro.Awdl\Nitro.Awdl.csproj" />
  </ItemGroup>

  <!-- The UI adapter is plain .NET (no WPF types); compile it here so it is tested on net10.0 without the WPF app. -->
  <ItemGroup>
    <Compile Include="..\AirDrop.App\Services\IAirDropService.cs" Link="App\IAirDropService.cs" />
    <Compile Include="..\AirDrop.App\Services\IContactResolver.cs" Link="App\IContactResolver.cs" />
    <Compile Include="..\AirDrop.App\Services\CoreAirDropService.cs" Link="App\CoreAirDropService.cs" />
    <Compile Include="..\AirDrop.App\Services\ContactBookResolver.cs" Link="App\ContactBookResolver.cs" />
  </ItemGroup>

  <!-- Setup wizard logic (no WPF, no registry): detection parsing, flow, vendor table, command builders, signing. -->
  <ItemGroup>
    <Compile Include="..\AirDrop.App\Setup\SetupPaths.cs" Link="App\Setup\SetupPaths.cs" />
    <Compile Include="..\AirDrop.App\Setup\SetupLog.cs" Link="App\Setup\SetupLog.cs" />
    <Compile Include="..\AirDrop.App\Setup\SetupState.cs" Link="App\Setup\SetupState.cs" />
    <Compile Include="..\AirDrop.App\Setup\SetupFlow.cs" Link="App\Setup\SetupFlow.cs" />
    <Compile Include="..\AirDrop.App\Setup\SupportedDevices.cs" Link="App\Setup\SupportedDevices.cs" />
    <Compile Include="..\AirDrop.App\Setup\VendorGuides.cs" Link="App\Setup\VendorGuides.cs" />
    <Compile Include="..\AirDrop.App\Setup\SetupCommands.cs" Link="App\Setup\SetupCommands.cs" />
    <Compile Include="..\AirDrop.App\Setup\CommandRunner.cs" Link="App\Setup\CommandRunner.cs" />
    <Compile Include="..\AirDrop.App\Setup\HelperProtocol.cs" Link="App\Setup\HelperProtocol.cs" />
    <Compile Include="..\AirDrop.App\Setup\FirmwareFetcher.cs" Link="App\Setup\FirmwareFetcher.cs" />
    <Compile Include="..\AirDrop.App\Setup\DriverPackage.cs" Link="App\Setup\DriverPackage.cs" />
    <Compile Include="..\AirDrop.App\Setup\DriverSource.cs" Link="App\Setup\DriverSource.cs" />
    <Compile Include="..\AirDrop.App\Setup\CodeSigner.cs" Link="App\Setup\CodeSigner.cs" />
  </ItemGroup>

  <!-- Explorer "NitroDrop ile gönder": command line parsing, send batching, HKCU verb / SendTo builder (WPF-free). -->
  <ItemGroup>
    <Compile Include="..\AirDrop.App\Services\UiStrings.cs" Link="App\Shell\UiStrings.cs" />
    <Compile Include="..\AirDrop.App\Services\LaunchArgs.cs" Link="App\Shell\LaunchArgs.cs" />
    <Compile Include="..\AirDrop.App\Services\SendBatcher.cs" Link="App\Shell\SendBatcher.cs" />
    <Compile Include="..\AirDrop.App\Services\ExplorerMenu.cs" Link="App\Shell\ExplorerMenu.cs" />
  </ItemGroup>

  <!-- "Telefon" tab logic (WPF-free): view model, demo continuity service, contacts/settings. -->
  <ItemGroup>
    <Compile Include="..\AirDrop.App\ViewModels\PhoneViewModel.cs" Link="App\Phone\PhoneViewModel.cs" />
    <Compile Include="..\AirDrop.App\Services\DemoContinuityService.cs" Link="App\Phone\DemoContinuityService.cs" />
    <Compile Include="..\AirDrop.App\Services\PhoneContacts.cs" Link="App\Phone\PhoneContacts.cs" />
    <Compile Include="..\AirDrop.App\Services\DeviceModels.cs" Link="App\DeviceModels.cs" />
  </ItemGroup>

</Project>