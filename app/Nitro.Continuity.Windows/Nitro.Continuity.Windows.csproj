<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinRT transport for iPhone continuity: pairing + LE link (IphoneLink), ANCS/AMS GATT clients, MAP (MAS client,
       MNS server) and PBAP over RFCOMM, and calls (PhoneLine when packaged, ANCS fallback). Protocol logic stays in
       Nitro.Continuity (pure, tested); this layer only moves bytes and maps WinRT results. Unpackaged-friendly. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Not "Nitro.Continuity.Windows": that namespace would shadow the global Windows.* WinRT namespaces. -->
    <RootNamespace>Nitro.Continuity.Platform</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nitro.Continuity\Nitro.Continuity.csproj" />
  </ItemGroup>

</Project>
