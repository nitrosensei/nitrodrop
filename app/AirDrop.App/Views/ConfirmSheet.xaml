<Window x:Class="AirDrop.App.Views.ConfirmSheet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NitroDrop" Width="390" SizeToContent="Height" ResizeMode="NoResize" Topmost="True"
        ShowInTaskbar="True" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
    <StackPanel Margin="28,28,28,24">
        <Grid Width="80" Height="80" HorizontalAlignment="Center">
            <Ellipse Fill="{DynamicResource SelfAvatar}"/>
            <TextBlock x:Name="Glyph" Text="&#xE7F8;" FontFamily="{StaticResource IconFont}" FontSize="32" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Border x:Name="BadgeBorder" Width="30" Height="30" CornerRadius="15" Background="{DynamicResource Badge}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.2"/>
                </Border.Effect>
                <TextBlock x:Name="Badge" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource Accent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <TextBlock x:Name="Who" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="Message" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>

        <!-- 6-digit pairing code -->
        <Border x:Name="CodeBox" CornerRadius="12" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1" Margin="0,18,0,0" Padding="12,14" Visibility="Collapsed">
            <TextBlock x:Name="Code" FontSize="36" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"
                       HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
        </Border>
        <TextBlock x:Name="Question" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"
                   Foreground="{DynamicResource TextSecondary}" Visibility="Collapsed"/>

        <Grid Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Content="İptal" Style="{StaticResource PillButton}" IsCancel="True" Click="Cancel_Click"/>
            <!-- Not IsDefault on purpose: confirming must be a deliberate click. -->
            <Button x:Name="AcceptButton" Grid.Column="2" Content="Onayla" Style="{StaticResource AccentPill}" Click="Accept_Click"/>
        </Grid>
        <TextBlock x:Name="Footnote" FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap"
                   TextAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
    </StackPanel>
    </Grid>
</Window>
