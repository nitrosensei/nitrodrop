<Window x:Class="AirDrop.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:AirDrop.App.Controls"
        xmlns:views="clr-namespace:AirDrop.App.Views"
        xmlns:pages="clr-namespace:AirDrop.App.Views.Pages"
        xmlns:l="clr-namespace:AirDrop.App.Localization"
        Title="NitroDrop" Width="1040" Height="720" MinWidth="420" MinHeight="540" ResizeMode="CanResize"
        Icon="/Assets/NitroDrop.ico"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextPrimary}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" AllowDrop="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" GlassFrameThickness="-1" ResizeBorderThickness="6"
                      CornerRadius="0" UseAeroCaptionButtons="True"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>

    <!--
      Responsive shell (code-behind ApplyLayout, Views/Responsive.cs):
        compact  < 720  title bar with lockup + segmented tabs + settings; below 600 the tabs move to their own row
        regular ≥ 720   left sidebar (lockup, icon + label navigation, Ayarlar at the bottom), single content column
        wide    ≥ 1100  sidebar + pages switch to two panes (Responsive.Mode = Wide is inherited by every page)
    -->
    <Grid x:Name="Shell">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Sidebar (regular / wide) ===== -->
        <Border x:Name="Sidebar" Grid.RowSpan="3" Width="212" Visibility="Collapsed"
                BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,0,12,14">
                <Image DockPanel.Dock="Top" Source="{DynamicResource BrandLockup}" Height="17" HorizontalAlignment="Left"
                       Margin="9,18,0,26" ToolTip="NitroDrop"/>
                <RadioButton DockPanel.Dock="Bottom" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE713;"
                             Content="{l:Loc Common_Settings}" IsChecked="{Binding IsSettings, Mode=TwoWay}"/>
                <StackPanel>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE701;"
                                 Content="{l:Loc Tab_Nearby}" IsChecked="{Binding IsNearby, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE7F8;"
                                 Content="{l:Loc Tab_Devices}" IsChecked="{Binding IsDevices, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE8EA;"
                                 Content="{l:Loc Tab_Phone}" IsChecked="{Binding IsPhone, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE81C;"
                                 Content="{l:Loc Tab_History}" IsChecked="{Binding IsHistory, Mode=TwoWay}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Title bar (compact): brand lockup, segmented control, settings ===== -->
        <Grid x:Name="TitleBar" Grid.Column="1" Margin="20,0,142,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleLockup" Source="{DynamicResource BrandLockup}" Height="17" HorizontalAlignment="Left"
                   VerticalAlignment="Center" Margin="0,1,12,0" ToolTip="NitroDrop"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Border x:Name="TitleTabsHost">
                    <Border x:Name="Segments" Style="{StaticResource SegmentBar}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="{l:Loc Tab_Nearby}" GroupName="tabs"
                                         IsChecked="{Binding IsNearby, Mode=TwoWay}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="{l:Loc Tab_Devices}" GroupName="tabs"
                                         IsChecked="{Binding IsDevices, Mode=TwoWay}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="{l:Loc Tab_Phone}" GroupName="tabs"
                                         IsChecked="{Binding IsPhone, Mode=TwoWay}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="{l:Loc Tab_History}" GroupName="tabs"
                                         IsChecked="{Binding IsHistory, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>
                </Border>
                <Button x:Name="SettingsButton" Content="&#xE713;" Margin="6,0,0,0" ToolTip="{l:Loc Common_Settings}"
                        Command="{Binding ShowTab}" CommandParameter="Settings">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSettings}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
        <!-- narrow compact (< 600): the segmented tabs get their own row under the title bar -->
        <Border x:Name="NarrowTabsHost" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" Margin="16,0,16,6"
                Visibility="Collapsed"/>

        <!-- ===== Pages ===== -->
        <Grid x:Name="PageHost" Grid.Row="2" Grid.Column="1">
            <pages:NearbyPage x:Name="NearbyView" Visibility="{Binding IsNearby, Converter={StaticResource BoolVis}}"/>
            <pages:DevicesPage x:Name="DevicesView" DataContext="{Binding Devices}"
                               Visibility="{Binding DataContext.IsDevices, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}"/>
            <!-- iPhone continuity (Views/PhonePanel) -->
            <views:PhonePanel x:Name="PhonePage" DataContext="{Binding Phone}" MaxWidth="1000"
                              Visibility="{Binding DataContext.IsPhone, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}"/>
            <pages:HistoryPage x:Name="HistoryView" Visibility="{Binding IsHistory, Converter={StaticResource BoolVis}}"/>
            <pages:SettingsPage x:Name="SettingsView" DataContext="{Binding Settings}"
                                Visibility="{Binding DataContext.IsSettings, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}"/>
        </Grid>
    </Grid>
</Window>
