<Window x:Class="AirDrop.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:AirDrop.App.Controls"
        Title="NitroDrop" Width="560" Height="740" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextPrimary}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" AllowDrop="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="True"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="0.18" To="1" Duration="0:0:2.6">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.18" To="1" Duration="0:0:2.6">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:2.6"/>
        </Storyboard>

        <Style x:Key="AppleProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{DynamicResource Track}" CornerRadius="2.5"/>
                            <Border x:Name="PART_Indicator" Background="{DynamicResource Accent}" CornerRadius="2.5"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="14,0,0,6"/>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="14,11"/>
        </Style>

        <!-- Avatar: photo when available, else gradient + initials -->
        <DataTemplate x:Key="PeerTemplate">
            <StackPanel x:Name="root" Width="132" Background="Transparent" AllowDrop="True" Cursor="Hand"
                        RenderTransformOrigin="0.5,0.35" Opacity="0"
                        Drop="Peer_Drop" DragEnter="Peer_DragEnter" DragOver="Peer_DragOver" DragLeave="Peer_DragLeave"
                        MouseLeftButtonUp="Peer_Click">
                <StackPanel.RenderTransform>
                    <ScaleTransform ScaleX="0.6" ScaleY="0.6"/>
                </StackPanel.RenderTransform>
                <StackPanel.ToolTip>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding DeviceLabel}"/>
                        <TextBlock Text="Tıklayın ya da dosyayı üzerine sürükleyin · sağ tık: seçenekler" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel.ToolTip>
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Dosya Gönder…" Click="Menu_SendFiles"/>
                        <MenuItem Header="Panoyu Gönder   (Ctrl+Alt+A)" Click="Menu_SendClipboard"/>
                        <Separator/>
                        <MenuItem Header="Fotoğraf Ata…" Click="Menu_SetPhoto"/>
                        <MenuItem Header="Fotoğrafı Kaldır" Click="Menu_ClearPhoto"/>
                        <MenuItem Header="Yeniden Adlandır…" Click="Menu_Rename"/>
                        <Separator/>
                        <MenuItem Header="Güvenilir Cihaz (sormadan kabul et)" IsCheckable="False"
                                  IsChecked="{Binding IsTrusted, Mode=OneWay}" Click="Menu_ToggleTrust"/>
                    </ContextMenu>
                </StackPanel.ContextMenu>

                <Grid Width="96" Height="96" HorizontalAlignment="Center">
                    <Ellipse Width="84" Height="84" Fill="{DynamicResource Avatar}">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.18"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="30" FontWeight="SemiBold"
                               FontFamily="{StaticResource DisplayFont}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse Width="84" Height="84" Visibility="{Binding HasAvatar, Converter={StaticResource BoolVis}}">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- device badge -->
                    <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource Badge}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.2"/>
                        </Border.Effect>
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{DynamicResource TextPrimary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- trusted badge -->
                    <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource Trusted}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0"
                            BorderBrush="{DynamicResource Badge}" BorderThickness="2"
                            Visibility="{Binding IsTrusted, Converter={StaticResource BoolVis}}"
                            ToolTip="Güvenilir cihaz — sormadan kabul edilir">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <ctl:ProgressArc Width="96" Height="96" Thickness="4" Progress="{Binding Progress}"
                                     Stroke="{DynamicResource Accent}" Track="{DynamicResource Track}"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                    <Ellipse x:Name="dropRing" Width="96" Height="96" Stroke="{DynamicResource Accent}"
                             StrokeThickness="4" Opacity="0" IsHitTestVisible="False"/>
                </Grid>

                <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="Medium" TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                <TextBlock x:Name="status" Text="{Binding StatusText}" FontSize="11.5" TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondary}" Margin="0,1,0,0"/>
            </StackPanel>

            <DataTemplate.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.35"/>
                            <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.45">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.45">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter TargetName="status" Property="Foreground" Value="{DynamicResource Accent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Sent">
                    <Setter TargetName="status" Property="Foreground" Value="{DynamicResource Accent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Declined">
                    <Setter TargetName="status" Property="Foreground" Value="#FF453A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter TargetName="status" Property="Foreground" Value="#FF453A"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="HistoryTemplate">
            <Border x:Name="row" Padding="10,9" CornerRadius="10" Background="Transparent" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding Open}"/>
                </Border.InputBindings>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Aç" Command="{Binding Open}"/>
                        <MenuItem Header="Klasörde Göster" Command="{Binding Reveal}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="44" Height="44">
                        <Border CornerRadius="9" Background="{DynamicResource Track}">
                            <TextBlock Text="{Binding KindGlyph}" FontFamily="{StaticResource IconFont}" FontSize="18"
                                       Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border CornerRadius="9" Visibility="{Binding HasThumbnail, Converter={StaticResource BoolVis}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource Badge}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4">
                            <TextBlock Text="{Binding DirectionGlyph}" FontFamily="{StaticResource IconFont}" FontSize="9"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="sub" Text="{Binding Subtitle}" FontSize="11.5" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="11.5" VerticalAlignment="Top"
                               Margin="0,3,2,0" Foreground="{DynamicResource TextSecondary}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="row" Property="Background" Value="{DynamicResource Track}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Failed}" Value="True">
                    <Setter TargetName="sub" Property="Foreground" Value="#FF453A"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>


        <!-- Slim overlay-style scroll bar (macOS-like): no arrows, no track, rounded thumb -->
        <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,4">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="t" CornerRadius="3" Width="6" Margin="2,0" Background="{DynamicResource TextSecondary}" Opacity="0.45"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="t" Property="Opacity" Value="0.7"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ===== Cihazlar (Nitro.Sync) ===== -->
        <Style x:Key="SmallAccentPill" TargetType="Button" BasedOn="{StaticResource AccentPill}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="SmallPill" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="SubHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="20,12,14,4"/>
        </Style>

        <DataTemplate x:Key="SyncTabTemplate">
            <Border x:Name="row" Padding="8,6" Margin="6,0" CornerRadius="8" Background="Transparent" Cursor="Hand"
                    ToolTip="{Binding Url}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding Open}"/>
                </Border.InputBindings>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Bu bilgisayarda aç" Command="{Binding Open}"/>
                        <MenuItem Header="Bağlantıyı kopyala" Command="{Binding CopyLink}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="24" Height="24" HorizontalAlignment="Left">
                        <Border CornerRadius="6" Background="{Binding Tile}">
                            <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="11.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border CornerRadius="6" Background="{DynamicResource Badge}"
                                Visibility="{Binding HasFavicon, Converter={StaticResource BoolVis}}">
                            <Image Source="{Binding Favicon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock x:Name="go" Grid.Column="2" Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="row" Property="Background" Value="{DynamicResource Track}"/>
                    <Setter TargetName="go" Property="Opacity" Value="1"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="SyncAppTemplate">
            <Border x:Name="row" Padding="8,6" Margin="6,0" CornerRadius="8" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="24" Height="24" HorizontalAlignment="Left">
                        <Border CornerRadius="6" Background="{Binding Tile}">
                            <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="11.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border CornerRadius="6" Background="{DynamicResource Track}"
                                Visibility="{Binding HasIcon, Converter={StaticResource BoolVis}}">
                            <Image Source="{Binding Icon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="Bu bilgisayarda aç" VerticalAlignment="Center"
                            Margin="0,0,4,0" Command="{Binding OpenHere}"
                            Visibility="{Binding CanOpenHere, Converter={StaticResource BoolVis}}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="row" Property="Background" Value="{DynamicResource Track}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- PC glyph in a circle; green dot when online -->
        <DataTemplate x:Key="PcAvatar">
            <Grid Width="40" Height="40">
                <Ellipse x:Name="circle" Fill="{DynamicResource SelfAvatar}"/>
                <TextBlock Text="&#xE7F8;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse x:Name="dot" Width="12" Height="12" Fill="{DynamicResource Trusted}" Stroke="{DynamicResource Badge}"
                         StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                    <Setter TargetName="circle" Property="Fill" Value="{DynamicResource Avatar}"/>
                    <Setter TargetName="dot" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="PcTemplate">
            <Border Style="{StaticResource Section}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid x:Name="head" Margin="14,12" Background="Transparent" Cursor="Hand">
                        <Grid.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding ToggleExpanded}"/>
                        </Grid.InputBindings>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PcAvatar}"/>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="chevron" Grid.Column="2" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"
                                   Visibility="{Binding CanExpand, Converter={StaticResource BoolVis}}"/>
                    </Grid>
                    <StackPanel Visibility="{Binding ShowContent, Converter={StaticResource BoolVis}}" Margin="0,0,0,8">
                        <Border Height="1" Background="{DynamicResource CardBorder}" Margin="14,0"/>
                        <StackPanel Visibility="{Binding HasTabs, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding TabsHeader}" Style="{StaticResource SubHeader}"/>
                            <ItemsControl ItemsSource="{Binding Tabs}" ItemTemplate="{StaticResource SyncTabTemplate}"/>
                            <Button Style="{StaticResource LinkButton}" Content="{Binding MoreTabsText}" Command="{Binding ToggleAllTabs}"
                                    Margin="52,4,0,2" HorizontalAlignment="Left"
                                    Visibility="{Binding HasMoreTabs, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasApps, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding AppsHeader}" Style="{StaticResource SubHeader}"/>
                            <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource SyncAppTemplate}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="chevron" Property="Text" Value="&#xE70E;"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="DiscoveredPcTemplate">
            <StackPanel Margin="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PcAvatar}"/>
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource SmallAccentPill}" Content="{Binding PairButtonText}"
                            Command="{Binding Pair}" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{Binding PairError}" FontSize="11.5" Foreground="#FF453A" TextWrapping="Wrap" Margin="52,4,0,0"
                           Visibility="{Binding HasPairError, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar: app name, segmented control, settings -->
        <Grid Margin="20,0,150,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE701;" FontFamily="{StaticResource IconFont}" FontSize="16"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="NitroDrop" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Border CornerRadius="9" Background="{DynamicResource SegmentTrack}" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="Yakındakiler" GroupName="tabs"
                                     IsChecked="{Binding IsNearby, Mode=TwoWay}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="Cihazlar" GroupName="tabs"
                                     IsChecked="{Binding IsDevices, Mode=TwoWay}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="Geçmiş" GroupName="tabs"
                                     IsChecked="{Binding IsHistory, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource IconButton}" Content="&#xE713;" Margin="8,0,0,0" ToolTip="Ayarlar"
                        Command="{Binding ShowTab}" CommandParameter="Settings"/>
            </StackPanel>
        </Grid>

        <!-- ============ NEARBY ============ -->
        <Grid Grid.Row="1" Visibility="{Binding IsNearby, Converter={StaticResource BoolVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel HorizontalAlignment="Center" Margin="0,2,0,0">
                <Border Padding="12,5" CornerRadius="12" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1" Visibility="{Binding IsDemo, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding HardwareStatus}" FontSize="11.5" Margin="6,0,0,0"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>
                <!-- Wi-Fi driver not installed on a supported card → "Gelişmiş Kurulum" -->
                <Border Padding="12,6" CornerRadius="12" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1" Margin="0,8,0,0" HorizontalAlignment="Center"
                        Visibility="{Binding DriverSetup.NeedsSetup, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE701;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                        <TextBlock Text="iPhone'larla doğrudan bağlantı için kurulum gerekli" FontSize="11.5" Margin="7,0,10,0"
                                   VerticalAlignment="Center"/>
                        <Button Style="{StaticResource LinkButton}" Content="Kur" FontWeight="SemiBold" FontSize="12"
                                VerticalAlignment="Center" Command="{Binding DriverSetup.OpenSetup}"/>
                    </StackPanel>
                </Border>
                <Border Padding="14,8" CornerRadius="12" Background="{DynamicResource Accent}" Margin="0,8,0,0"
                        Visibility="{Binding HasPending, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE724;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="White"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PendingText}" Foreground="White" FontSize="12.5" FontWeight="Medium"
                                   Margin="8,0,12,0" MaxWidth="360" TextTrimming="CharacterEllipsis"/>
                        <Button Style="{StaticResource LinkButton}" Foreground="White" Content="Vazgeç"
                                Command="{Binding CancelPending}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Canvas Grid.Row="1" Width="440" Height="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="440" Height="440" Stroke="{DynamicResource Ring}" StrokeThickness="1.2"/>
                <Ellipse Width="300" Height="300" Canvas.Left="70" Canvas.Top="70" Stroke="{DynamicResource Ring}" StrokeThickness="1.2"/>
                <Ellipse Width="160" Height="160" Canvas.Left="140" Canvas.Top="140" Stroke="{DynamicResource Ring}" StrokeThickness="1.2"/>

                <Ellipse x:Name="Pulse1" Width="440" Height="440" Fill="{DynamicResource Pulse}" Opacity="0"
                         RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Pulse2" Width="440" Height="440" Fill="{DynamicResource Pulse}" Opacity="0"
                         RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                </Ellipse>

                <StackPanel Canvas.Left="160" Canvas.Top="178" Width="120">
                    <Grid Width="68" Height="68">
                        <Ellipse Fill="{DynamicResource SelfAvatar}">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.3" Color="{DynamicResource AccentColor}"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="&#xE7F8;" FontFamily="{StaticResource IconFont}" FontSize="28" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding ComputerName}" FontSize="11.5" FontWeight="Medium" TextAlignment="Center"
                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Peers}" ItemTemplate="{StaticResource PeerTemplate}" Width="440" Height="440">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </Canvas>

            <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" FontSize="12.5"
                       Foreground="{DynamicResource TextSecondary}" Text="Yakındaki iPhone, iPad ve Mac'ler aranıyor…">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasPeers}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Grid.Row="2" Margin="32,4,32,22">
                <Border Padding="16,12" CornerRadius="14" Background="{DynamicResource Card}" Margin="0,0,0,14"
                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                        Visibility="{Binding IsReceiving, Converter={StaticResource BoolVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                   Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="12,0">
                            <TextBlock Text="{Binding ReceiveTitle}" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                            <ProgressBar Style="{StaticResource AppleProgress}" Margin="0,7,0,0" Maximum="1"
                                         Value="{Binding ReceiveProgress, Mode=OneWay}"/>
                            <TextBlock Text="{Binding ReceiveDetail}" FontSize="11" Margin="0,5,0,0"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="Klasörü Göster"
                                VerticalAlignment="Center" Command="{Binding OpenReceiveFolder}"/>
                    </Grid>
                </Border>

                <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"
                           Text="Yakınınızdaki iPhone, iPad ve Mac'lerle anında paylaşın. Dosyayı bir kişinin üzerine sürükleyin ya da tıklayıp seçin."/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <TextBlock Text="Sizi bulabilecek kişiler:" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0"/>
                    <ComboBox Style="{StaticResource ModeCombo}" ItemsSource="{Binding Modes}"
                              SelectedItem="{Binding SelectedMode}" VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                <Setter Property="IsEnabled" Value="{Binding Enabled}"/>
                                <Setter Property="ToolTip" Value="{Binding Hint}"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                </StackPanel>
                <TextBlock Text="{Binding VisibilityText}" HorizontalAlignment="Center" FontSize="11.5" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
        </Grid>

        <!-- ============ DEVICES (Nitro.Sync) ============ -->
        <Grid Grid.Row="1" Margin="20,8,20,0" DataContext="{Binding Devices}" x:Name="DevicesPage"
              Visibility="{Binding DataContext.IsDevices, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="10,0,6,10">
                <TextBlock Text="Cihazlarım" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
                <Button Style="{StaticResource LinkButton}" FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding ToggleAddPc}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,1,6,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAddingPc}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding AddPcButtonText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" x:Name="DevicesScroll">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel Margin="0,0,0,20">
                    <!-- iPhone'da şu an -->
                    <Border Style="{StaticResource Section}" Margin="0,0,0,14" Padding="14,12"
                            Visibility="{Binding HasIphoneActivity, Converter={StaticResource BoolVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="44" Height="44">
                                <Border CornerRadius="11" Background="{Binding IphoneAppTile}">
                                    <TextBlock Text="{Binding IphoneAppInitial}" Foreground="White" FontSize="19" FontWeight="SemiBold"
                                               FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource Badge}"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.2"/>
                                    </Border.Effect>
                                    <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                               Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="IPHONE'DA ŞU AN" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding IphoneHeadline}" FontSize="13.5" FontWeight="SemiBold" Margin="0,1,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding IphoneDetail}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource SmallAccentPill}" Content="PC'de devam et"
                                    VerticalAlignment="Center" Command="{Binding ContinueOnPc}"
                                    Visibility="{Binding CanContinue, Converter={StaticResource BoolVis}}"/>
                            <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Width="26" Height="26"
                                    Margin="6,0,-4,0" VerticalAlignment="Center" ToolTip="Kapat" Command="{Binding DismissIphone}"
                                    Foreground="{DynamicResource TextSecondary}"/>
                        </Grid>
                    </Border>

                    <!-- Bilgisayar ekle: unpaired NitroDrop PCs on the LAN -->
                    <StackPanel Visibility="{Binding IsAddingPc, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="AĞDAKİ NITRODROP BİLGİSAYARLARI" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Section}" Margin="0,0,0,14">
                            <StackPanel Margin="0,2">
                                <ItemsControl ItemsSource="{Binding Discovered}" ItemTemplate="{StaticResource DiscoveredPcTemplate}"/>
                                <StackPanel Margin="14,12" Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasDiscovered}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Aranıyor…" FontSize="13"/>
                                        <TextBlock Text="Diğer bilgisayarda NitroDrop açık olmalı ve aynı ağa bağlı olmalı."
                                                   FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="EŞLEŞTİRİLMİŞ" Style="{StaticResource SectionTitle}"
                                   Visibility="{Binding HasPaired, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Paired}" ItemTemplate="{StaticResource PcTemplate}"/>

                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center" Margin="40,56,40,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasPaired}" Value="False"/>
                                            <Condition Binding="{Binding IsAddingPc}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid Width="72" Height="72" HorizontalAlignment="Center">
                            <Ellipse Fill="{DynamicResource Track}"/>
                            <TextBlock Text="&#xE7F8;" FontFamily="{StaticResource IconFont}" FontSize="30"
                                       Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Bilgisayarlarınızı eşleştirin" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Margin="0,16,0,0"/>
                        <TextBlock Text="Eşleşen bilgisayarlar birbirinin açık sekmelerini ve uygulamalarını görür; tek tıkla burada açarsınız."
                                   FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="340"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <Button Style="{StaticResource AccentPill}" Content="Bilgisayar ekle" HorizontalAlignment="Center" Margin="0,18,0,0"
                                Command="{Binding ToggleAddPc}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding SyncError}" FontSize="11.5" Foreground="#FF453A" TextWrapping="Wrap" Margin="14,4"
                               Visibility="{Binding HasSyncError, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ HISTORY ============ -->
        <Grid Grid.Row="1" Margin="20,8,20,20" Visibility="{Binding IsHistory, Converter={StaticResource BoolVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="10,0,6,8">
                <TextBlock Text="Son Aktarımlar" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource LinkButton}" Content="Klasörü Aç" Command="{Binding OpenReceiveFolder}" Margin="0,0,16,0"/>
                    <Button Style="{StaticResource LinkButton}" Content="Temizle" Command="{Binding ClearHistory}"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Section}" Margin="0" Padding="6">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
                        </ScrollViewer.Resources>
                        <ItemsControl ItemsSource="{Binding History}" ItemTemplate="{StaticResource HistoryTemplate}"/>
                    </ScrollViewer>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasHistory}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="34" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="Henüz bir şey paylaşılmadı" FontSize="13" Margin="0,10,0,0" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ SETTINGS ============ -->
        <Grid Grid.Row="1" DataContext="{Binding Settings}" x:Name="SettingsPage"
              Visibility="{Binding DataContext.IsSettings, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="24,6,24,10">
                <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Geri" Click="Settings_Back"/>
                <TextBlock Text="Ayarlar" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"
                           Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,20">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel>
                    <TextBlock Text="BU BİLGİSAYAR" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="Görünen ad" FontSize="13" VerticalAlignment="Center"/>
                                <TextBox Style="{StaticResource FlatText}" Width="240" HorizontalAlignment="Right"
                                         Text="{Binding DeviceName, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource CardBorder}" Margin="14,0"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel>
                                    <TextBlock Text="Alınanları kaydet" FontSize="13"/>
                                    <TextBlock Text="{Binding ReceiveFolder}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="330" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <Button Style="{StaticResource LinkButton}" Content="Değiştir…" FontSize="13"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding ChooseFolder}"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource CardBorder}" Margin="14,0"/>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="Windows ile başlat" FontSize="13" VerticalAlignment="Center"/>
                                <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding StartWithWindows}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ALMA" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="iPhone fotoğrafları JPG olarak gelsin" FontSize="13"/>
                                    <TextBlock Text="HEIC yerine JPG, HEVC videolar yerine H.264 istenir. Her Windows'ta açılır."
                                               FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          IsChecked="{Binding PreferCompatibleFormats}"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource CardBorder}" Margin="14,0"/>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="Gelen bağlantıları tarayıcıda aç" FontSize="13" VerticalAlignment="Center"/>
                                <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding OpenLinksAutomatically}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ORTAK PANO" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Gelenleri panoya kopyala" FontSize="13"/>
                                    <TextBlock Text="iPhone'dan AirDrop ile gelen metin, bağlantı ve tek fotoğraf Ctrl+V ile yapıştırılmaya hazır olur."
                                               FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          IsChecked="{Binding CopyIncomingToClipboard}"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource CardBorder}" Margin="14,0"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,120,0">
                                    <TextBlock Text="Panoyu telefona gönder" FontSize="13"/>
                                    <TextBlock Text="Kopyaladığınız metin, bağlantı, görsel ya da dosyayı son kullandığınız cihaza yollar."
                                               FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="6" Padding="8,3"
                                        Background="{DynamicResource Track}">
                                    <TextBlock Text="{Binding HotkeyStatus}" FontSize="12" FontWeight="Medium"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="KİŞİLER VE FOTOĞRAFLAR" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="{Binding ContactStatus}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="14,0,14,12">
                                <Button Style="{StaticResource AccentPill}" Content="Rehberi İçe Aktar (.vcf)" Command="{Binding ImportContacts}"/>
                                <Button Style="{StaticResource PillButton}" Content="Temizle" Margin="10,0,0,0" Command="{Binding ClearContacts}"/>
                            </StackPanel>
                            <TextBlock Margin="14,0,14,12" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                                       Text="Mac'teki gibi çalışır: iPhone'un gönderdiği doğrulanmış kimlik yalnızca sizin rehberinizle eşleştirilir. Rehber bu bilgisayardan dışarı çıkmaz."/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="GÜVENİLİR CİHAZLAR" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Trusted}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="14,9">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="13"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
                                            </StackPanel>
                                            <Button Style="{StaticResource LinkButton}" Content="Kaldır" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center" Command="{Binding Remove}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="14,11" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                                       Text="Bir cihaza sağ tıklayıp “Güvenilir Cihaz”ı seçin; ondan gelenler sormadan kabul edilir.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasTrusted}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ===== Senkron (Nitro.Sync) ===== -->
                    <StackPanel x:Name="SyncSettings"
                                DataContext="{Binding DataContext.Devices, RelativeSource={RelativeSource AncestorType=Window}}">
                        <TextBlock Text="SENKRON" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <StackPanel Margin="0,0,60,0">
                                        <TextBlock Text="Sekmelerimi paylaş" FontSize="13"/>
                                        <TextBlock Text="Chrome ve Edge'deki açık sekmeleriniz eşleşen bilgisayarlarda görünür. Gizli sekmeler hiç paylaşılmaz."
                                                   FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                    <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding ShareTabs}"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource CardBorder}" Margin="14,0"/>
                                <Grid Style="{StaticResource Row}">
                                    <StackPanel Margin="0,0,60,0">
                                        <TextBlock Text="Açık uygulamalarımı paylaş" FontSize="13"/>
                                        <TextBlock Text="Yalnızca uygulama adı, simgesi ve pencere başlığı gider; dosya yolları bu bilgisayarda kalır."
                                                   FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                    <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding ShareApps}"/>
                                </Grid>
                                <StackPanel Visibility="{Binding ShareApps, Converter={StaticResource BoolVis}}">
                                    <Border Height="1" Background="{DynamicResource CardBorder}" Margin="14,0"/>
                                    <StackPanel Margin="14,11,14,12">
                                        <TextBlock Text="Paylaşılmayacak uygulamalar" FontSize="13"/>
                                        <TextBlock Text="Parola yöneticileri ve sistem süreçleri zaten hariç."
                                                   FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                                        <ItemsControl ItemsSource="{Binding ExcludedApps}" Margin="0,8,0,0"
                                                      Visibility="{Binding HasExcludedApps, Converter={StaticResource BoolVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="8" Background="{DynamicResource Track}" Padding="10,4,4,4" Margin="0,0,6,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center"/>
                                                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="8" Width="20" Height="20"
                                                                    Margin="4,0,0,0" ToolTip="Kaldır"
                                                                    Command="{Binding DataContext.RemoveExcluded, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="8" Background="{DynamicResource Track}" Padding="10,5">
                                                <Grid>
                                                    <TextBox x:Name="ExcludeBox" Style="{StaticResource FlatText}" HorizontalContentAlignment="Left"
                                                             Text="{Binding NewExcludedApp, UpdateSourceTrigger=PropertyChanged}">
                                                        <TextBox.InputBindings>
                                                            <KeyBinding Key="Enter" Command="{Binding AddExcluded}"/>
                                                        </TextBox.InputBindings>
                                                    </TextBox>
                                                    <TextBlock Text="Uygulama dosyası, ör. Telegram.exe" FontSize="13" IsHitTestVisible="False"
                                                               Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=ExcludeBox}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                            <Button Grid.Column="1" Style="{StaticResource SmallPill}" Content="Ekle" Margin="8,0,0,0"
                                                    Command="{Binding AddExcluded}"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="TARAYICI EKLENTİSİ" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="ExtDot" Width="9" Height="9" VerticalAlignment="Top" Margin="0,5,10,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource TextSecondary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ExtensionConnected}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource Trusted}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding ExtensionStatus}" FontSize="13"/>
                                        <TextBlock Text="{Binding ExtensionDetail}" FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource SmallPill}" Content="Eklentiyi kur" VerticalAlignment="Center"
                                            Command="{Binding ToggleExtensionHelp}"/>
                                </Grid>
                                <!-- short help: load unpacked + register the native host -->
                                <StackPanel Visibility="{Binding ShowExtensionHelp, Converter={StaticResource BoolVis}}">
                                    <Border Height="1" Background="{DynamicResource CardBorder}" Margin="14,0"/>
                                    <StackPanel Margin="14,12,14,14">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Accent}" VerticalAlignment="Top">
                                                <TextBlock Text="1" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" FontSize="12.5" TextWrapping="Wrap" Margin="0,1,0,0">
                                                Chrome'da <Run FontWeight="SemiBold">chrome://extensions</Run>, Edge'de <Run FontWeight="SemiBold">edge://extensions</Run>
                                                adresini açın ve <Run FontWeight="SemiBold">Geliştirici modu</Run>'nu açın.
                                            </TextBlock>
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Accent}" VerticalAlignment="Top">
                                                <TextBlock Text="2" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontSize="12.5" TextWrapping="Wrap" Margin="0,1,0,0">
                                                    <Run FontWeight="SemiBold">Paketlenmemiş öğe yükle</Run>'ye basıp bu klasörü seçin:
                                                </TextBlock>
                                                <Border CornerRadius="8" Background="{DynamicResource Track}" Padding="10,6" Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding ExtensionFolder}" FontSize="11.5" FontFamily="Consolas"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ExtensionFolder}"/>
                                                </Border>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Button Style="{StaticResource LinkButton}" Content="Klasörü aç" Command="{Binding OpenExtensionFolder}"/>
                                                    <Button Style="{StaticResource LinkButton}" Content="Yolu kopyala" Margin="16,0,0,0"
                                                            Command="{Binding CopyExtensionFolder}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Accent}" VerticalAlignment="Top">
                                                <TextBlock Text="3" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontSize="12.5" TextWrapping="Wrap" Margin="0,1,0,0"
                                                           Text="Eklentinin NitroDrop ile konuşabilmesi için tarayıcıya bağlayın (yalnızca bu kullanıcı için, yönetici izni gerekmez)."/>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Button Style="{StaticResource SmallAccentPill}" Content="Tarayıcıya bağla" Command="{Binding RegisterExtension}"/>
                                                    <TextBlock Text="{Binding RegisterStatus}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                                               VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="250"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="EŞLEŞTİRİLMİŞ BİLGİSAYARLAR" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Paired}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="14,9">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="13"/>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,0,60,0"/>
                                                </StackPanel>
                                                <Button Style="{StaticResource LinkButton}" Content="Kaldır" HorizontalAlignment="Right"
                                                        VerticalAlignment="Center" Command="{Binding Unpair}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="14,11" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                                           Text="Henüz eşleştirilmiş bilgisayar yok. Cihazlar sekmesinden “Bilgisayar ekle”yi kullanın.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPaired}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="IPHONE (KESTİRME)" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding IosDevices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="14,9">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="13"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
                                                </StackPanel>
                                                <Button Style="{StaticResource LinkButton}" Content="Kaldır" HorizontalAlignment="Right"
                                                        VerticalAlignment="Center" Command="{Binding Remove}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Height="1" Background="{DynamicResource CardBorder}" Margin="14,0"
                                        Visibility="{Binding HasIosDevices, Converter={StaticResource BoolVis}}"/>

                                <!-- one-time setup QR -->
                                <StackPanel Visibility="{Binding HasIosSetup, Converter={StaticResource BoolVis}}" Margin="14,14,14,4">
                                    <TextBlock Text="{Binding IosSetupTitle}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <Border Width="196" Height="196" CornerRadius="12" Background="White" Margin="0,10,0,0" Padding="2"
                                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                                        <Image Source="{Binding IosQr}" RenderOptions.EdgeMode="Aliased" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Text="iPhone'da Kamera ile okutun ve adresi kestirmedeki “URL'nin İçeriğini Al” eylemine yapıştırın."
                                               FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center" Margin="10,10,10,0"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <Border CornerRadius="8" Background="{DynamicResource Track}" Padding="10,6" Margin="0,10,0,0">
                                        <TextBox Text="{Binding IosUrl, Mode=OneWay}" IsReadOnly="True" FontSize="11" FontFamily="Consolas"
                                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}"
                                                 TextWrapping="Wrap"/>
                                    </Border>
                                    <TextBlock Text="Bu adres bir kez gösterilir ve iPhone'a özel bir anahtar içerir; yalnızca kendi telefonunuza aktarın."
                                               FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondary}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
                                        <Button Style="{StaticResource LinkButton}" Content="Adresi kopyala" Command="{Binding CopyIosUrl}"/>
                                        <Button Style="{StaticResource LinkButton}" Content="Kestirme talimatları" Margin="18,0,0,0"
                                                Command="{Binding OpenShortcutHelp}"/>
                                        <Button Style="{StaticResource LinkButton}" Content="Bitti" Margin="18,0,0,0" FontWeight="SemiBold"
                                                Command="{Binding CloseIosSetup}"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Style="{StaticResource Row}">
                                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,150,0"
                                               Text="iPhone'da açılan uygulama ve paylaştığınız bağlantılar Kestirmeler ile bu bilgisayara gelir."/>
                                    <Button Style="{StaticResource SmallAccentPill}" Content="iPhone ekle" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Command="{Binding AddIphone}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="WI-FI SÜRÜCÜSÜ" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Section}"
                            DataContext="{Binding DataContext.DriverSetup, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{Binding StateText}" FontSize="13"/>
                                    <TextBlock Text="{Binding DetailText}" FontSize="11.5" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="14,0,14,12">
                                <Button Style="{StaticResource AccentPill}" Content="Kur…" Command="{Binding OpenSetup}"
                                        Visibility="{Binding CanInstall, Converter={StaticResource BoolVis}}" Margin="0,0,10,0"/>
                                <Button Style="{StaticResource PillButton}" Content="Kaldır ve eski haline getir…" Command="{Binding OpenRollback}"
                                        Visibility="{Binding CanRollback, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                               Text="Nitrobyte · açık kaynak · ücretsiz"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
