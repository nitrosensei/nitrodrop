<UserControl x:Class="AirDrop.App.Views.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:AirDrop.App.Controls"
             xmlns:l="clr-namespace:AirDrop.App.Localization"
             xmlns:views="clr-namespace:AirDrop.App.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <!-- ===== History row ===== -->
        <DataTemplate x:Key="HistoryTemplate">
            <Border x:Name="row" Padding="12,10" CornerRadius="10" Background="Transparent" Cursor="Hand"
                    MouseLeftButtonUp="Row_Click">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding Open}"/>
                </Border.InputBindings>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{l:Loc Common_Open}" Command="{Binding Open}"/>
                        <MenuItem Header="{l:Loc Common_ShowInFolder}" Command="{Binding Reveal}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="42" Height="42">
                        <Border CornerRadius="10" Background="{DynamicResource SurfaceSunken}" BorderBrush="{DynamicResource Separator}" BorderThickness="1">
                            <TextBlock Text="{Binding KindGlyph}" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border CornerRadius="10" Visibility="{Binding HasThumbnail, Converter={StaticResource BoolVis}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource Badge}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5">
                            <TextBlock Text="{Binding DirectionGlyph}" FontFamily="{StaticResource IconFont}" FontSize="8.5"
                                       Foreground="{DynamicResource TextPrimary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                        <DockPanel Margin="0,2,0,0">
                            <ctl:DeviceArtIcon DockPanel.Dock="Left" Width="13" Height="13" Margin="0,0,5,0" StrokeWeight="1.8"
                                               ArtKey="{Binding ArtKey}" Stroke="{DynamicResource TextSecondary}"
                                               ToolTip="{Binding DeviceLabel}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="sub" Text="{Binding Subtitle}" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" Style="{StaticResource MonoLabel}" VerticalAlignment="Top"
                               Margin="0,3,2,0"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="row" Property="Background" Value="{DynamicResource Hover}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Failed}" Value="True">
                    <Setter TargetName="sub" Property="Foreground" Value="{DynamicResource DangerText}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="True"/>
                        <Condition Binding="{Binding (views:Responsive.Mode), ElementName=row}" Value="Wide"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="row" Property="Background" Value="{DynamicResource SegmentTrack}"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- wide layout: preview of the selected transfer -->
        <DataTemplate x:Key="HistoryPreviewTemplate">
            <StackPanel Margin="20,20,20,18">
                <Border CornerRadius="12" Background="{DynamicResource SurfaceSunken}" BorderBrush="{DynamicResource Separator}"
                        BorderThickness="1" Height="240" ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="{Binding KindGlyph}" FontFamily="{StaticResource IconFont}" FontSize="44"
                                   Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border CornerRadius="11" Visibility="{Binding HasPreview, Converter={StaticResource BoolVis}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Preview}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}"
                           TextWrapping="Wrap" Margin="0,16,0,0"/>
                <TextBlock x:Name="sub" Text="{Binding Subtitle}" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                <DockPanel Margin="0,10,0,0">
                    <ctl:DeviceArtIcon DockPanel.Dock="Left" Width="15" Height="15" Margin="0,0,7,0" StrokeWeight="1.8"
                                       ArtKey="{Binding ArtKey}" Stroke="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DeviceLabel}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="{Binding FullTime}" Style="{StaticResource MonoLabel}" Margin="0,8,0,0"/>
                <StackPanel Visibility="{Binding HasItems, Converter={StaticResource BoolVis}}" Margin="0,16,0,0">
                    <TextBlock Text="{Binding ItemsHeader}" Style="{StaticResource SubHeader}" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,2"
                                           ToolTip="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <WrapPanel Margin="0,18,0,0">
                    <Button Style="{StaticResource SmallAccentPill}" Content="{l:Loc Common_Open}" Command="{Binding Open}" Margin="0,0,8,6"/>
                    <Button Style="{StaticResource SmallPill}" Content="{l:Loc Common_ShowInFolder}" Command="{Binding Reveal}" Margin="0,0,8,6"/>
                </WrapPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Failed}" Value="True">
                    <Setter TargetName="sub" Property="Foreground" Value="{DynamicResource DangerText}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <!-- ============ HISTORY ============ -->
    <!-- compact/regular: one list (max 720). Wide (HistoryPage.xaml.cs): list + preview of the selected transfer. -->
    <Grid x:Name="Root" Margin="28,10,28,24" MaxWidth="720">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="*"/>
            <ColumnDefinition x:Name="DetailColumn" Width="0"/>
        </Grid.ColumnDefinitions>
        <Grid Margin="4,0,0,14" Grid.ColumnSpan="2">
            <TextBlock Text="{l:Loc History_Title}" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource SmallSubtlePill}" Content="{l:Loc Common_Clear}" Command="{Binding ClearHistory}" Margin="0,0,6,0"/>
                <Button Style="{StaticResource SmallPill}" Content="{l:Loc Common_OpenFolder}" Command="{Binding OpenReceiveFolder}"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Section}" Margin="0" Padding="6">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="List" ItemsSource="{Binding History}" ItemTemplate="{StaticResource HistoryTemplate}"/>
                </ScrollViewer>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasHistory}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource SurfaceSunken}"
                            BorderBrush="{DynamicResource Separator}" BorderThickness="1" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                   Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{l:Loc History_EmptyTitle}" TextAlignment="Center" TextWrapping="Wrap" FontSize="15" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}"
                               Margin="0,16,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="{l:Loc History_EmptyBody}"
                               Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="DetailPane" Grid.Row="1" Grid.Column="1" Style="{StaticResource Section}" Margin="16,0,0,0"
                Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="DetailHost" ContentTemplate="{StaticResource HistoryPreviewTemplate}" Focusable="False"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
