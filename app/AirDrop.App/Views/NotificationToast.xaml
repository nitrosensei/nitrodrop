<Window x:Class="AirDrop.App.Views.NotificationToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:AirDrop.App.Views"
        xmlns:l="clr-namespace:AirDrop.App.Localization"
        Title="{l:Loc Phone_Toast_Title}" Width="360" SizeToContent="Height" ResizeMode="NoResize" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- DataContext = NotificationItem; actions go to the PhoneViewModel passed to the constructor. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <v:VisibleConverter x:Key="Vis"/>
        <v:HexBrushConverter x:Key="Hex"/>
        <Style x:Key="ToastPill" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Body" Padding="14,12,12,12" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Body_Click">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="20" Height="20" CornerRadius="5" Background="{Binding AppColor, Converter={StaticResource Hex}}">
                    <TextBlock Text="{Binding AppGlyph}" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource OnTile}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding AppName}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                           Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Width="22" Height="22"
                        ToolTip="{l:Loc Common_Close}" Click="Close_Click"/>
            </Grid>
            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Subtitle}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding HasSubtitle, Converter={StaticResource Vis}}"/>
            <TextBlock x:Name="MessageText" Text="{Binding Message}" FontSize="12.5" TextWrapping="Wrap" MaxHeight="52"
                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
            <WrapPanel x:Name="Actions" Margin="0,9,0,0">
                <Button Style="{StaticResource ToastPill}" Content="{Binding ContinueLabel}" Click="Continue_Click"
                        Visibility="{Binding CanContinue, Converter={StaticResource Vis}}"/>
                <Button Style="{StaticResource ToastPill}" Content="{Binding PositiveLabel}" Click="Positive_Click"
                        Visibility="{Binding HasPositive, Converter={StaticResource Vis}}"/>
                <Button Style="{StaticResource ToastPill}" Content="{Binding NegativeLabel}" Click="Negative_Click"
                        Visibility="{Binding HasNegative, Converter={StaticResource Vis}}"/>
            </WrapPanel>
        </StackPanel>
    </Border>
</Window>
