<Window x:Class="AirDrop.App.Views.SetupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NitroDrop · Gelişmiş Kurulum" Width="600" Height="760" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextPrimary}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="True"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <LinearGradientBrush x:Key="PositiveCircle" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5BD97A" Offset="0"/>
            <GradientStop Color="#28B04B" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="WizCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0,18,0,0"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource CardBorder}"/>
            <Setter Property="Margin" Value="14,0"/>
        </Style>
        <Style x:Key="SmallPill" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style x:Key="HideWhenNull" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- title bar -->
        <StackPanel Orientation="Horizontal" Margin="20,0,150,0" VerticalAlignment="Center">
            <TextBlock Text="&#xE701;" FontFamily="{StaticResource IconFont}" FontSize="14"
                       Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
            <TextBlock Text="Gelişmiş Kurulum" FontSize="13" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
            <Border Margin="10,0,0,0" Padding="7,2" CornerRadius="6" Background="#33FF9F0A"
                    Visibility="{Binding IsDryRun, Converter={StaticResource BoolVis}}"
                    ToolTip="--setup-dry-run: komutlar çalıştırılmaz, yalnızca kurulum günlüğüne yazılır">
                <TextBlock Text="DRY-RUN · hiçbir şey değişmez" FontSize="10.5" FontWeight="SemiBold" Foreground="#FF9F0A"/>
            </Border>
        </StackPanel>

        <!-- progress dots -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Dots}" HorizontalAlignment="Center" Margin="0,6,0,0"
                      Visibility="{Binding ShowDots, Converter={StaticResource BoolVis}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="dot" Width="8" Height="8" CornerRadius="4" Margin="4,0"
                            Background="{DynamicResource Track}" ToolTip="{Binding Title}"/>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                            <Setter TargetName="dot" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="dot" Property="Opacity" Value="0.45"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter TargetName="dot" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="dot" Property="Opacity" Value="1"/>
                            <Setter TargetName="dot" Property="Width" Value="26"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <StackPanel Margin="44,14,44,8">
                <!-- big icon -->
                <Border Width="76" Height="76" CornerRadius="38" HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SelfAvatar}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GlyphPositive}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PositiveCircle}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.22"/>
                    </Border.Effect>
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="34" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,18,0,0"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="13.5" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"
                           LineHeight="20" Foreground="{DynamicResource TextSecondary}"/>

                <!-- ===== Compatibility ===== -->
                <Border Style="{StaticResource WizCard}" HorizontalAlignment="Center" Padding="16,10"
                        Visibility="{Binding IsCompatibility, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE711;"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSupported}" Value="True">
                                            <Setter Property="Text" Value="&#xE73E;"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Trusted}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding CardText}" FontSize="13" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ===== Consent ===== -->
                <StackPanel Visibility="{Binding IsConsent, Converter={StaticResource BoolVis}}">
                    <Border Style="{StaticResource WizCard}" Padding="0,6">
                        <ItemsControl ItemsSource="{Binding ConsentItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="16,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource Track}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                       Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="{Binding Body}" Style="{StaticResource Body}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <Border Style="{StaticResource WizCard}">
                        <Grid Margin="16,12">
                            <TextBlock Text="Bunları okudum, anladım ve kabul ediyorum." Style="{StaticResource RowTitle}"
                                       VerticalAlignment="Center" Margin="0,0,60,0"/>
                            <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding ConsentChecked}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ===== BitLocker ===== -->
                <StackPanel Visibility="{Binding IsBitLocker, Converter={StaticResource BoolVis}}">
                    <Border Style="{StaticResource WizCard}">
                        <StackPanel>
                            <Grid Margin="16,12">
                                <TextBlock Text="{Binding BitLockerStateText}" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource SmallPill}" Content="Anahtarı göster…" HorizontalAlignment="Right"
                                        Command="{Binding CheckBitLocker}" ToolTip="Yönetici izni istenir; anahtar yalnızca bu pencerede kullanılır"/>
                            </Grid>
                            <StackPanel Visibility="{Binding HasRecoveryText, Converter={StaticResource BoolVis}}">
                                <Border Style="{StaticResource Divider}"/>
                                <TextBlock Text="{Binding RecoveryKeyIds}" Style="{StaticResource Body}" Margin="16,10,16,0"
                                           FontFamily="Cascadia Mono, Consolas"/>
                                <StackPanel Orientation="Horizontal" Margin="16,10,16,12"
                                            Visibility="{Binding HasRecoveryDetails, Converter={StaticResource BoolVis}}">
                                    <Button Style="{StaticResource AccentPill}" Content="Dosyaya kaydet…" Command="{Binding SaveRecoveryKey}"/>
                                    <Button Style="{StaticResource PillButton}" Content="Kaydet ve yazdır…" Margin="10,0,0,0" Command="{Binding PrintRecoveryKey}"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Style="{StaticResource Divider}"/>
                            <Button Style="{StaticResource LinkButton}" Margin="16,11" FontSize="12.5" HorizontalAlignment="Left"
                                    Content="Microsoft hesabımdaki anahtarı aç (aka.ms/myrecoverykey)" Command="{Binding OpenMyRecoveryKey}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource WizCard}" Visibility="{Binding BitLockerNeedsBackup, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <Grid Margin="16,12">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Yeniden başlatırken BitLocker'ı bir kez askıya al" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,2,0,0"
                                               Text="Önerilir. Açılışta anahtar sorulmasını önler; disk şifreli kalır ve koruma bir yeniden başlatmadan sonra kendiliğinden geri gelir."/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          IsChecked="{Binding SuspendOnReboot}"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Margin="16,12">
                                <TextBlock Text="Kurtarma anahtarımı bu bilgisayarın dışında güvenli bir yere kaydettim." Style="{StaticResource RowTitle}"
                                           VerticalAlignment="Center" Margin="0,0,60,0"/>
                                <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          IsChecked="{Binding BackupConfirmed}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Secure Boot / rollback guide ===== -->
                <Border Style="{StaticResource WizCard}" Visibility="{Binding ShowGuide, Converter={StaticResource BoolVis}}">
                    <StackPanel Margin="16,14">
                        <Grid>
                            <TextBlock Text="{Binding Guide.DisplayName}" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="{Binding MachineText}" FontSize="11.5" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding GuideSteps}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="19"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Guide.Note}" Style="{StaticResource HideWhenNull}" Margin="0,10,0,0"/>
                        <Border Style="{StaticResource Divider}" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding GuideKeys}" Style="{StaticResource Body}" Margin="0,10,0,0"/>
                        <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0"
                                   Text="Açılışta BitLocker kurtarma anahtarı sorulursa, kaydettiğiniz 48 haneli anahtarı yazın."/>
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource LinkButton}" Content="Durumu yeniden kontrol et" HorizontalAlignment="Center"
                        Margin="0,12,0,0" FontSize="12.5" Command="{Binding Recheck}"
                        Visibility="{Binding IsSecureBoot, Converter={StaticResource BoolVis}}"/>

                <!-- ===== Test signing ===== -->
                <StackPanel Visibility="{Binding IsTestSigning, Converter={StaticResource BoolVis}}">
                    <Border Style="{StaticResource WizCard}" Padding="16,12" Background="#1AFF9F0A" BorderBrush="#40FF9F0A"
                            Visibility="{Binding SecureBootStillOn, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock Text="Secure Boot hâlâ açık görünüyor" Style="{StaticResource RowTitle}"/>
                            <TextBlock Style="{StaticResource Body}" Margin="0,2,0,0"
                                       Text="Windows bu durumda test modunu açmayı reddeder. Önce Secure Boot adımını tamamlayın."/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource LinkButton}" Content="Durumu yeniden kontrol et" HorizontalAlignment="Center"
                            Margin="0,12,0,0" FontSize="12.5" Command="{Binding Recheck}"/>
                </StackPanel>

                <!-- ===== Install ===== -->
                <StackPanel Visibility="{Binding IsInstall, Converter={StaticResource BoolVis}}">
                    <Border Style="{StaticResource WizCard}" Visibility="{Binding FirmwareReady, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock Text="Intel firmware lisansı" Style="{StaticResource RowTitle}" Margin="16,12,16,6"/>
                            <TextBox Text="{Binding LicenseText, Mode=OneWay}" IsReadOnly="True" Height="150" Margin="16,0,16,12"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondary}"/>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Margin="16,12">
                                <TextBlock Text="Intel firmware lisansını okudum ve kabul ediyorum." Style="{StaticResource RowTitle}"
                                           VerticalAlignment="Center" Margin="0,0,60,0"/>
                                <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          IsChecked="{Binding LicenseAccepted}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding LogLines}" Margin="4,14,4,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11" FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ===== Done ===== -->
                <StackPanel Visibility="{Binding IsDone, Converter={StaticResource BoolVis}}" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button Style="{StaticResource LinkButton}" Content="Kaldır ve eski haline getir" FontSize="12.5"
                            HorizontalAlignment="Center" Command="{Binding StartRollback}"/>
                </StackPanel>

                <!-- ===== Rollback ===== -->
                <Border Style="{StaticResource WizCard}" Padding="0,6" Visibility="{Binding IsRollback, Converter={StaticResource BoolVis}}">
                    <ItemsControl ItemsSource="{Binding RollbackItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="16,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,2,0,0"
                                               Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- status / error -->
                <TextBlock Text="{Binding Status}" FontSize="12.5" TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,0"
                           Foreground="{DynamicResource Accent}" Visibility="{Binding HasStatus, Converter={StaticResource BoolVis}}"/>
                <Border CornerRadius="10" Padding="14,10" Margin="0,16,0,0" Background="#1AFF453A" BorderBrush="#40FF453A" BorderThickness="1"
                        Visibility="{Binding HasError, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding Error}" FontSize="12.5" TextWrapping="Wrap" Foreground="#FF453A"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- footer -->
        <Grid Grid.Row="3" Margin="32,10,32,24">
            <Button Style="{StaticResource PillButton}" Content="{Binding SecondaryText}" HorizontalAlignment="Left"
                    Command="{Binding Secondary}" IsEnabled="{Binding SecondaryEnabled}"
                    Visibility="{Binding SecondaryVisible, Converter={StaticResource BoolVis}}"/>
            <Button Style="{StaticResource LinkButton}" Content="Kurulum günlüğü" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Foreground="{DynamicResource TextSecondary}" Command="{Binding OpenLog}"/>
            <Button HorizontalAlignment="Right" Content="{Binding PrimaryText}" Command="{Binding Primary}"
                    IsEnabled="{Binding PrimaryEnabled}" MinWidth="150">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource AccentPill}">
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</Window>
