<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NitroDrop</AssemblyName>
    <RootNamespace>AirDrop.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\NitroDrop.ico</ApplicationIcon>
    <Product>NitroDrop</Product>
    <Company>Nitrobyte</Company>
    <!-- DPI comes from app.manifest (WPF); WinForms is only used for the tray icon -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AirDrop.Core\AirDrop.Core.csproj" />
    <ProjectReference Include="..\Nitro.Sync\Nitro.Sync.csproj" />
    <!-- iPhone continuity ("Telefon" tab): WinRT transport + pure protocol code. -->
    <ProjectReference Include="..\Nitro.Continuity.Windows\Nitro.Continuity.Windows.csproj" />
    <!-- Native messaging host (NitroDrop.SyncHost.exe): built first, copied next to NitroDrop.exe below. -->
    <ProjectReference Include="..\Nitro.Sync.Host\Nitro.Sync.Host.csproj" ReferenceOutputAssembly="false" Private="false" />
    <!-- iPhone link: pipe client + BLE advert (Nitro.Awdl), and the elevated radio host NitroDrop.Radio.exe (copied below). -->
    <ProjectReference Include="..\Nitro.Awdl\Nitro.Awdl.csproj" />
    <ProjectReference Include="..\Nitro.Radio.Host\Nitro.Radio.Host.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- NitroDrop.Radio.exe (requireAdministrator) + dll/runtimeconfig/deps next to NitroDrop.exe; CoreAirDropService starts
       it with "runas". Same TFM as the app, so Nitro.Awdl.dll / wintun\{arch}\wintun.dll already in the output serve both. -->
  <PropertyGroup>
    <RadioHostDir>..\Nitro.Radio.Host\bin\$(Configuration)\net10.0-windows10.0.22621.0\</RadioHostDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(RadioHostDir)NitroDrop.Radio.exe" Link="NitroDrop.Radio.exe" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(RadioHostDir)NitroDrop.Radio.dll" Link="NitroDrop.Radio.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(RadioHostDir)NitroDrop.Radio.runtimeconfig.json" Link="NitroDrop.Radio.runtimeconfig.json" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(RadioHostDir)NitroDrop.Radio.deps.json" Link="NitroDrop.Radio.deps.json" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\vendor\wintun\LICENSE.txt" Link="licenses\wintun-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" Visible="false"
          Condition="Exists('..\..\vendor\wintun\LICENSE.txt')" />
  </ItemGroup>

  <!-- Browser extension (load unpacked from <output>\extension) and the iPhone Shortcut guide. -->
  <ItemGroup>
    <None Include="..\..\extension\**\*" Link="extension\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\ios-shortcut.md" Link="docs\ios-shortcut.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- NitroDrop.SyncHost.exe + its dll/runtimeconfig/deps go next to NitroDrop.exe (the extension registers that path).
       Explicit paths (no wildcard) so they are included before the host is built; the ProjectReference builds it first. -->
  <PropertyGroup>
    <SyncHostDir>..\Nitro.Sync.Host\bin\$(Configuration)\net10.0-windows\</SyncHostDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(SyncHostDir)NitroDrop.SyncHost.exe" Link="NitroDrop.SyncHost.exe" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(SyncHostDir)NitroDrop.SyncHost.dll" Link="NitroDrop.SyncHost.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(SyncHostDir)NitroDrop.SyncHost.runtimeconfig.json" Link="NitroDrop.SyncHost.runtimeconfig.json" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(SyncHostDir)NitroDrop.SyncHost.deps.json" Link="NitroDrop.SyncHost.deps.json" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- Wi-Fi driver package for the setup wizard (Setup/): INF, built .sys and the UNSIGNED catalog from
       driver\package.ps1. The wizard signs the .sys/.cat per install; the firmware is downloaded. -->
  <ItemGroup>
    <None Include="..\..\driver\airdropwifi.inf" Link="driver\airdropwifi.inf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\driver\out\airdropwifi.sys" Link="driver\airdropwifi.sys" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\driver\out\airdropwifi.sys')" />
    <None Include="..\..\driver\out\airdropwifi.cat" Link="driver\airdropwifi.cat" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\driver\out\airdropwifi.cat')" />
  </ItemGroup>
  <!-- Brand assets (brand/final): embedded fonts (static instances of the OFL variable fonts), window/tray icons.
       Font licences are copied to <output>\licenses (OFL requires them to travel with the fonts). -->
  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\NitroDrop.ico" />
    <Resource Include="Assets\tray-light.ico" />
    <Resource Include="Assets\tray-dark.ico" />
    <Resource Include="Assets\NitroDrop-256.png" />
    <None Include="Assets\Fonts\OFL-*.txt" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

</Project>
