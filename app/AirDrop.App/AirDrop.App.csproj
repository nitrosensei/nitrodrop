<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NitroDrop</AssemblyName>
    <RootNamespace>AirDrop.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>NitroDrop</Product>
    <Company>Nitrobyte</Company>
    <!-- DPI comes from app.manifest (WPF); WinForms is only used for the tray icon -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AirDrop.Core\AirDrop.Core.csproj" />
  </ItemGroup>

  <!-- Wi-Fi driver package for the setup wizard (Setup/): INF, built .sys and the UNSIGNED catalog from
       driver\package.ps1. The wizard signs the .sys/.cat per install; the firmware is downloaded. -->
  <ItemGroup>
    <None Include="..\..\driver\airdropwifi.inf" Link="driver\airdropwifi.inf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\driver\out\airdropwifi.sys" Link="driver\airdropwifi.sys" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\driver\out\airdropwifi.sys')" />
    <None Include="..\..\driver\out\airdropwifi.cat" Link="driver\airdropwifi.cat" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\driver\out\airdropwifi.cat')" />
  </ItemGroup>

</Project>
