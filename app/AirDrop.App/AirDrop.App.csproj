<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NitroDrop</AssemblyName>
    <RootNamespace>AirDrop.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>NitroDrop</Product>
    <Company>Nitrobyte</Company>
    <!-- DPI comes from app.manifest (WPF); WinForms is only used for the tray icon -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AirDrop.Core\AirDrop.Core.csproj" />
  </ItemGroup>

</Project>
