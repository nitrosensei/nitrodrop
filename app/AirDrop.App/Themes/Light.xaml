<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#007AFF</Color>
    <SolidColorBrush x:Key="Accent" Color="#007AFF"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#0062CC"/>
    <SolidColorBrush x:Key="WindowFallback" Color="#F2F2F7"/>
    <SolidColorBrush x:Key="Card" Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#14000000"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#8A8A8E"/>
    <SolidColorBrush x:Key="Ring" Color="#1A007AFF"/>
    <SolidColorBrush x:Key="Pulse" Color="#33007AFF"/>
    <SolidColorBrush x:Key="Badge" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonNeutral" Color="#E5E5EA"/>
    <SolidColorBrush x:Key="ButtonNeutralHover" Color="#D8D8DE"/>
    <SolidColorBrush x:Key="Track" Color="#1F000000"/>
    <SolidColorBrush x:Key="SegmentOn" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SegmentTrack" Color="#14000000"/>
    <SolidColorBrush x:Key="Trusted" Color="#34C759"/>
    <LinearGradientBrush x:Key="Avatar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A5ABB8" Offset="0"/>
        <GradientStop Color="#858994" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SelfAvatar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#5AC8FA" Offset="0"/>
        <GradientStop Color="#007AFF" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
