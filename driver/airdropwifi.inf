;
; airdropwifi.inf - airdrop-win KMDF driver for Intel Wi-Fi 6 AX203 (So + Hr2)
;
; Copyright (c) 2026 Nitrobyte / airdrop-win contributors. ISC license.
;
; NOT installed automatically. The Intel inbox driver (Netwtw*) matches the
; same hardware ID; this driver is selected explicitly ("Update driver" ->
; "Let me pick", or pnputil) and removing it restores the Intel driver.
;
; Package layout expected by this INF (all files in one folder):
;   airdropwifi.inf, airdropwifi.cat, airdropwifi.sys,
;   iwlwifi-so-a0-hr-b0-77.ucode   (tools\fetch-firmware.ps1)
;
; Adding other iwx (AX201/AX203/AX101 on So/So-F) devices:
;   1. add the hardware ID below (PCI\VEN_8086&DEV_xxxx&SUBSYS_yyyy8086),
;   2. add the PCI device ID to iwx_attach() in core/iwx_init.c with the
;      parameters from OpenBSD if_iwx.c's switch for that ID,
;   3. if it needs another firmware, ship it and add it to CopyFiles.
; Devices outside the So/So-F + Hr table (core/iwx_init.c) are rejected by
; iwx_attach() even if listed here.
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
CatalogFile = airdropwifi.cat
DriverVer   = 10/28/2026,0.1.0.0
PnpLockdown = 1

[Manufacturer]
%ProviderName% = AirdropWifi, NTamd64.10.0...22000

[AirdropWifi.NTamd64.10.0...22000]
%DeviceDesc% = AirdropWifi_Install, PCI\VEN_8086&DEV_51F1&SUBSYS_02748086

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
airdropwifi.sys              = 1
iwlwifi-so-a0-hr-b0-77.ucode = 1

[DestinationDirs]
; 13 = driver store (package isolation); the driver finds the firmware
; through IoGetDriverDirectory(DriverDirectoryImage).
AirdropWifi_CopyFiles = 13

[AirdropWifi_CopyFiles]
airdropwifi.sys
iwlwifi-so-a0-hr-b0-77.ucode

; ---------------------------------------------------------------------------

[AirdropWifi_Install.NT]
CopyFiles = AirdropWifi_CopyFiles

[AirdropWifi_Install.NT.HW]
AddReg = AirdropWifi_HW_AddReg

[AirdropWifi_HW_AddReg]
; one MSI/MSI-X message: iwx maps every cause to vector 0
HKR, "Interrupt Management",,0x00000010
HKR, "Interrupt Management\MessageSignaledInterruptProperties",,0x00000010
HKR, "Interrupt Management\MessageSignaledInterruptProperties", MSISupported, 0x00010001, 1
HKR, "Interrupt Management\MessageSignaledInterruptProperties", MessageNumberLimit, 0x00010001, 1
; raw 802.11 injection: SYSTEM and Administrators only
HKR,, Security,, "D:P(A;;GA;;;SY)(A;;GA;;;BA)"

[AirdropWifi_Install.NT.Services]
AddService = airdropwifi, 0x00000002, AirdropWifi_Service

[AirdropWifi_Service]
DisplayName   = %ServiceDesc%
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START (PnP)
ErrorControl  = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\airdropwifi.sys
AddReg        = AirdropWifi_Service_AddReg

[AirdropWifi_Service_AddReg]
; all DMA goes through KMDF common buffers (DMA adapter logical addresses),
; so the device works with DMA remapping / Kernel DMA Protection enabled
HKR, Parameters, DmaRemappingCompatible, 0x00010001, 1

[AirdropWifi_Install.NT.Wdf]
KmdfService = airdropwifi, AirdropWifi_WdfSect

[AirdropWifi_WdfSect]
KmdfLibraryVersion = 1.33

; ---------------------------------------------------------------------------

[Strings]
ProviderName = "airdrop-win"
DiskName     = "airdrop-win driver package"
DeviceDesc   = "Intel Wi-Fi 6 AX203 (airdrop-win raw 802.11)"
ServiceDesc  = "airdrop-win Wi-Fi raw 802.11 driver"
